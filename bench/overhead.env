# Overhead-isolation profile: mocks answer in ~1ms with no errors and no limits, so the
# benchmark measures the gateway's own ceiling and per-request cost.
#   docker compose --env-file bench/overhead.env up -d --force-recreate mock-a mock-b mock-c api
MOCK_A_LATENCY_MIN_MS=1
MOCK_A_LATENCY_MAX_MS=1
MOCK_A_ERROR_RATE=0
MOCK_A_RATE_LIMIT_RPS=0
MOCK_BC_LATENCY_MIN_MS=1
MOCK_BC_LATENCY_MAX_MS=1
MOCK_BC_ERROR_RATE=0
MOCK_BC_TIMEOUT_RATE=0
MOCK_BC_RATE_LIMIT_RPS=0
PROVIDER_A_RPS=1000000
PROVIDER_B_RPS=1000000
PROVIDER_C_RPS=1000000
INBOUND_RATE_RPS=1000000
INBOUND_BURST=1000000
