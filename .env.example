# Copy to .env to override defaults. Every value here is optional.

# Build-time PyPI mirror (empty = pypi.org)
# PIP_MIRROR=http://nexus.internal/repository/pypi/simple/
# PIP_MIRROR_HOST=nexus.internal

# Point the gateway at the real starter-kit providers instead of the local mocks:
# PROVIDER_A_URL=http://92.114.51.251:8001/v1/process
# PROVIDER_B_URL=http://92.114.51.251:8002/v1/process
# PROVIDER_C_URL=http://92.114.51.251:8003/v1/process

# Outbound limits (global across replicas). A is deliberately optimistic: AIMD finds the real limit.
# PROVIDER_A_RPS=200
# PROVIDER_B_RPS=1000
# PROVIDER_C_RPS=1000

# Scale
# API_REPLICAS=4
# CONSUMER_REPLICAS=2
# MAX_INFLIGHT=4000          # per api replica, then 503 (load shedding)
# INBOUND_RATE_RPS=20000     # per API key
# INBOUND_BURST=40000

# Host ports
# GATEWAY_PORT=8088
# GRAFANA_PORT=3300
# PROMETHEUS_PORT=9095
# JAEGER_UI_PORT=16686
# RABBITMQ_UI_PORT=15673

# Observability
# LOG_LEVEL=INFO
# OTEL_SAMPLE_RATIO=0.05
